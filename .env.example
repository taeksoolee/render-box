# Cloudflare API token for one deploy environment (another account, staging...).
# Copy to .env.<env> (e.g. .env.client-a) and put the real token there.
# .env.<env> is gitignored; this example file is not, so keep it a placeholder.
#
# Token: Manage Account (or My Profile) > API Tokens > Create Token
#   template "Edit Cloudflare Workers" + Add more: Account / D1 / Edit
#
# Use it per command (only inside the parentheses):
#   (set -a; . ./.env.client-a; pnpm setup:remote --env client-a --account <account id>)
#   (set -a; . ./.env.client-a; pnpm key create --remote --env client-a)
CLOUDFLARE_API_TOKEN=cfut_replace_me

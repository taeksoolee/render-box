{
  "name": "render-box",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @render-box/admin --filter @render-box/render dev",
    "test": "vitest run",
    "typecheck": "for p in apps/admin apps/render packages/auth packages/db packages/shared; do tsc -p $p --noEmit || exit 1; done",
    "db:generate": "pnpm --filter @render-box/db generate",
    "db:migrate:local": "pnpm --filter @render-box/admin exec wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "key": "tsx scripts/key.ts",
    "setup:local": "tsx scripts/setup-local.ts && pnpm db:migrate:local",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

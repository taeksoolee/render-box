{
  "name": "render-box",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "test": "vitest run",
    "typecheck": "for p in apps/admin apps/render apps/api packages/auth packages/db packages/documents packages/shared; do tsc -p $p --noEmit || exit 1; done",
    "db:generate": "pnpm --filter @render-box/db generate",
    "db:migrate:local": "pnpm --filter @render-box/admin exec wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "tsx scripts/deploy.ts migrate",
    "deploy:prod": "tsx scripts/deploy.ts deploy",
    "check:headers": "tsx scripts/check-headers.ts",
    "check:prod-mode": "pnpm --filter @render-box/admin build:assets && tsx scripts/check-prod-mode.ts",
    "key": "tsx scripts/key.ts",
    "project": "tsx scripts/project.ts",
    "setup:local": "tsx scripts/setup-local.ts && pnpm db:migrate:local",
    "setup:remote": "tsx scripts/setup-remote.ts",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "Share HTML prototypes by URL, rendered in isolation on Cloudflare Workers"
}
